---
// A row (or column) of marquee bulbs (GUIDE §8.4–8.5): the hero's sign frame
// and the footer. As many bulbs as fit are shown, spread evenly so none is cut
// off; the rest wrap onto a hidden line. With `chase`, they light in sequence
// once, from `from` ms over `span` ms, then all stay lit. Without motion they
// are simply lit.
interface Props {
  /** At least as many as can fit; extras stay hidden. */
  count?: number;
  vertical?: boolean;
  chase?: boolean;
  /** Light from the far end. */
  reverse?: boolean;
  from?: number;
  span?: number;
  class?: string;
}
const {
  count = 64,
  vertical = false,
  chase = false,
  reverse = false,
  from = 0,
  span = 1200,
  class: cls = '',
} = Astro.props;
const delays = Array.from({ length: count }, (_, i) => Math.round(from + ((reverse ? count - 1 - i : i) * span) / count));
---

<div class:list={['bulbs', vertical && 'bulbs-v', chase && 'bulbs-chase', cls]} aria-hidden="true">
  {delays.map((d) => <span class="bulb" style={chase ? `--d:${d}ms` : undefined} />)}
</div>

<style>
  .bulbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 7px;
    overflow: hidden;
    block-size: 6px;
    inline-size: 100%;
    /* Never size the parent: a column takes the height it is given. */
    contain: strict;
  }
  .bulbs-v {
    flex-direction: column;
    block-size: 100%;
    inline-size: 6px;
  }
  .bulb {
    position: relative;
    flex: none;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 9999px;
    background: var(--color-velvet-strong);
  }
  .bulb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-bulb);
  }
  .bulbs-chase .bulb::after {
    animation: bulb-on 180ms var(--ease-out) var(--d, 0ms) both;
  }
  @keyframes bulb-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
