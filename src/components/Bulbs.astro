---
// A row (or column) of marquee bulbs (GUIDE §8.4–8.5): the hero's sign frame
// and the footer. As many bulbs as fit are shown, spread evenly so none is cut
// off; the rest wrap onto a hidden line.
//
// With `chase`, the visible bulbs light one after another, once, from the
// row's first bulb to its last in exactly --chase (1 s), whatever the row's
// size (src/lib/bulbs.ts works out how many are visible). `from="end"` starts
// at the far end (lays the row out reversed), so two rows can run towards
// each other's corners. Without motion they are simply lit.
interface Props {
  /** At least as many as can fit; extras stay hidden. */
  count?: number;
  vertical?: boolean;
  chase?: boolean;
  /** Where the chase starts: the row's start (or a column's top), or its end (bottom). */
  from?: 'start' | 'end';
  class?: string;
}
const { count = 64, vertical = false, chase = false, from = 'start', class: cls = '' } = Astro.props;
---

<div
  class:list={['bulbs', vertical && 'bulbs-v', chase && 'bulbs-chase', from === 'end' && 'bulbs-from-end', cls]}
  aria-hidden="true"
>
  {Array.from({ length: count }, (_, i) => <span class="bulb" style={chase ? `--i:${i}` : undefined} />)}
</div>

<style>
  .bulbs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 7px;
    overflow: hidden;
    block-size: 6px;
    inline-size: 100%;
    /* Never size the parent: a column takes the height it is given. And each
       row is a size container, so its bulbs can tell how many fit. */
    contain: strict;
    container-type: size;
  }
  .bulbs-v {
    flex-direction: column;
    block-size: 100%;
    inline-size: 6px;
  }
  .bulbs-from-end {
    flex-direction: row-reverse;
  }
  .bulbs-v.bulbs-from-end {
    flex-direction: column-reverse;
  }
  .bulb {
    position: relative;
    flex: none;
    inline-size: 6px;
    block-size: 6px;
    border-radius: 9999px;
    background: var(--color-velvet-strong);
    /* Visible bulbs; set per size by chaseCss(). A guess for browsers
       without container queries. */
    --n: 30;
  }
  .bulb::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-bulb);
  }
  .bulbs-chase .bulb::after {
    animation-name: bulb-on;
    animation-duration: 200ms;
    animation-timing-function: var(--ease-out);
    animation-fill-mode: both;
    animation-delay: calc(var(--i, 0) / max(var(--n) - 1, 1) * var(--chase, 1000ms));
  }
  @keyframes bulb-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
