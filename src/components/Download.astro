---
// The box office (GUIDE §6). The full device picker arrives in W4.
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { dict, type Locale } from '../i18n';
import type { Release } from '../lib/release';

interface Props {
  locale: Locale;
  release: Release;
}
const { locale, release } = Astro.props;
const t = dict(locale);
---

<section id="download" class="wrap scroll-mt-6 py-16 sm:py-24" aria-labelledby="download-title">
  <SectionHead id="download-title" eyebrow={t.download.eyebrow} title={t.download.title}>
    <p class="mt-5 text-title font-semibold text-cream">{t.download.pick}</p>
    <p class="mt-1 text-cream-soft">{t.download.pickNote}</p>
  </SectionHead>
  {import.meta.env.DEV || release.source === 'sample' ? <p class="mb-6 text-caption text-ember">{t.download.sample}</p> : null}
  <a href={release.allReleasesUrl} class="btn-secondary">
    <Icon name="github" size={18} />
    {t.download.allVersions}
  </a>
</section>
