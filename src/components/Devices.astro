---
// The screen under the sign: the app on a computer, with a phone standing in
// front of its corner. The phone covers the computer's side menu, which is on
// the left of the (English) desktop screenshot in both languages.
import { Picture } from 'astro:assets';
import { screen } from '../lib/screens';
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: cls = '' } = Astro.props;
const t = dict(locale);
const phone = screen(`phone-home-${locale}`);
const desktop = screen('desktop-home-en');
---

<div class:list={['devices mx-auto grid w-full max-w-[64rem]', cls]}>
  <div class="desktop w-[88%] justify-self-center rounded-panel border border-velvet bg-booth p-1.5 sm:p-2.5">
    <Picture
      src={desktop}
      alt={t.hero.desktopAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[480, 720, 960, 1280, 1800]}
      sizes="(min-width: 75rem) 900px, 88vw"
      loading="eager"
      decoding="async"
      class="block h-auto w-full rounded-card bg-screen"
    />
  </div>
  <div class="phone w-[24%] self-end rounded-device border border-velvet bg-booth p-1 sm:p-2">
    <Picture
      src={phone}
      alt={t.hero.phoneAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[160, 240, 360, 480]}
      sizes="(min-width: 75rem) 245px, 24vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block h-auto w-full rounded-device-screen bg-screen"
    />
  </div>
</div>

<style>
  /* One grid cell: the phone starts lower than the computer, so it stands in
     front of the computer's bottom corner and a little below it. */
  .devices > * {
    grid-area: 1 / 1;
  }
  .phone {
    justify-self: start;
    margin-block-start: 16%;
  }
  /* The desktop screenshot is the English (LTR) one in both languages: keep the phone
     over its side menu (on the left) on Arabic pages too. */
  .devices:dir(rtl) .phone {
    justify-self: end;
  }
</style>
