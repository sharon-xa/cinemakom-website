---
// The hero's picture: a phone in a CSS-drawn frame, overlapping a computer
// screen set back behind it. The posters inside bring the page's colour.
import { Picture } from 'astro:assets';
import { screen } from '../lib/screens';
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
const phone = screen(`phone-home-${locale}`);
const desktop = screen('desktop-home-en');
---

<div class="devices relative mx-auto w-full max-w-[40rem]">
  <div class="desktop absolute end-0 top-0 w-[88%] rounded-panel border border-velvet bg-booth p-1.5 sm:p-2">
    <Picture
      src={desktop}
      alt={t.hero.desktopAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 64rem) 560px, 88vw"
      loading="lazy"
      decoding="async"
      class="block h-auto w-full rounded-card bg-screen"
    />
  </div>
  <div class="phone absolute start-0 bottom-0 w-[36%] rounded-device border border-velvet bg-booth p-1.5 sm:p-2">
    <Picture
      src={phone}
      alt={t.hero.phoneAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[160, 240, 360, 480]}
      sizes="(min-width: 64rem) 230px, 36vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="block h-auto w-full rounded-device-screen bg-screen"
    />
  </div>
</div>

<style>
  /* Tall enough for the phone (36% wide at 780×1688, plus its frame). */
  .devices {
    aspect-ratio: 10 / 8.4;
  }
</style>
