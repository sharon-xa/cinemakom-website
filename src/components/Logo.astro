---
// The lockup: the mark beside CINEMAKOM (Big Shoulders 800, cream) over
// سينماكم (Reem Kufi 700, bulb). On Arabic pages the Arabic name leads.
import Mark from './Mark.astro';
import type { Locale } from '../lib/format';

interface Props {
  locale: Locale;
  size?: number;
  class?: string;
}
const { locale, size = 36, class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2 sm:gap-2.5', cls]}>
  <Mark size={size} class="shrink-0" />
  <span class:list={['flex', locale === 'ar' ? 'flex-col-reverse' : 'flex-col']} style={`font-size:${Math.round(size * 0.5)}px`}>
    <span lang="en" class="block font-display text-[1.1em] leading-[0.95] font-extrabold tracking-[0.02em] text-cream">
      CINEMAKOM
    </span>
    <span lang="ar" class="block font-display text-[0.95em] leading-[1.15] font-bold text-bulb">سينماكم</span>
  </span>
</span>
