---
// The marquee sign: a huge two-line headline framed by bulb rows, then the
// lede, the one primary button, the version and the Earthlink notice.
import Bulbs from './Bulbs.astro';
import Devices from './Devices.astro';
import Icon from './Icon.astro';
import { dict, fill, type Locale } from '../i18n';
import type { Release } from '../lib/release';
import { formatDate } from '../lib/format';

interface Props {
  locale: Locale;
  release: Release;
}
const { locale, release } = Astro.props;
const t = dict(locale);
const caption = fill(t.hero.caption, {
  version: `<bdi dir="ltr" data-version="version">${release.version}</bdi>`,
  date: `<span data-version="date">${formatDate(release.publishedAt, locale)}</span>`,
});
---

<section class="hero wrap pt-10 pb-16 sm:pt-16 sm:pb-24" aria-labelledby="hero-title">
  <p class="eyebrow mb-5">{t.hero.eyebrow}</p>
  <Bulbs count={140} dim={[9, 52, 97]} chase class="mb-6 sm:mb-8" />
  <h1 id="hero-title" class="headline font-display text-hero text-cream">
    {t.hero.headline.map((line) => <span class="block">{line}</span>)}
  </h1>
  <Bulbs count={140} dim={[33, 34, 120]} chase reverse class="mt-6 sm:mt-8" />

  <div class="mt-10 grid items-center gap-12 sm:mt-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
    <div>
      <p class="max-w-[34ch] text-[1.25rem] leading-relaxed text-cream-soft sm:text-[1.375rem]">{t.hero.lede}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href="#download" class="btn-primary min-h-14 px-8 text-[1.0625rem]">
          <Icon name="download" size={20} />
          {t.hero.cta}
        </a>
        <p class="text-caption text-dust" set:html={caption} />
      </div>
      <div class="mt-8 flex max-w-[44ch] gap-4 rounded-card border border-velvet bg-booth p-5" role="note">
        <Icon name="signal" size={24} class="mt-0.5 text-bulb" />
        <p class="text-[0.9375rem] leading-relaxed text-cream-soft">
          <strong class="mb-1 block text-label font-semibold text-cream">{t.hero.earthlinkTitle}</strong>
          {t.hero.earthlink}
        </p>
      </div>
      <p class="mt-6 text-caption text-dust">{t.hero.platforms}</p>
    </div>
    <Devices locale={locale} />
  </div>
</section>

<style>
  .headline {
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  .headline:lang(ar) {
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    /* Reem Kufi sits wide: keep the two lines at the same visual weight as Latin caps. */
    font-size: clamp(3.25rem, 10vw, 8.25rem);
  }
</style>
