---
// The front of the picture palace (GUIDE §8.5). At the top, the marquee sign:
// the headline on a booth panel framed by bulbs on all four sides, chasing once
// round it. Under it, the lede, the one primary button with the version, and
// the Earthlink notice. Then the screen: the app on a computer and a phone,
// which bring the page its colour.
import Bulbs from './Bulbs.astro';
import Devices from './Devices.astro';
import Icon, { type IconName } from './Icon.astro';
import { dict, fill, type Locale } from '../i18n';
import type { Release } from '../lib/release';
import { formatDate } from '../lib/format';

interface Props {
  locale: Locale;
  release: Release;
}
const { locale, release } = Astro.props;
const t = dict(locale);
const caption = fill(t.hero.caption, {
  version: `<bdi dir="ltr" data-version="version">${release.version}</bdi>`,
  date: `<span data-version="date">${formatDate(release.publishedAt, locale)}</span>`,
});
const platformIcons: IconName[] = ['phone', 'tv', 'monitor', 'terminal'];
---

<section class="hero wrap pt-6 pb-16 sm:pt-10 sm:pb-24" aria-labelledby="hero-title">
  <div class="sign rounded-panel border border-velvet bg-booth">
    <Bulbs class="top" count={120} chase span={450} />
    <Bulbs class="side-end" vertical count={48} chase from={450} span={150} />
    <Bulbs class="bottom" count={120} chase reverse from={600} span={450} />
    <Bulbs class="side-start" vertical count={48} chase reverse from={1050} span={150} />
    <div class="board px-2 py-6 text-center sm:py-9 lg:py-10">
      <p class="eyebrow mb-4 sm:mb-5">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="headline font-display text-cream">
        {t.hero.headline.map((line, i) => [i > 0 ? ' ' : '', <span class="line">{line}</span>])}
      </h1>
    </div>
  </div>

  <div class="mx-auto mt-9 flex max-w-[48rem] flex-col items-center text-center sm:mt-10">
    <p class="max-w-[46ch] text-[1.1875rem] leading-relaxed text-cream-soft sm:text-[1.3125rem]">{t.hero.lede}</p>
    <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row sm:gap-5">
      <a href="#download" class="btn-primary min-h-14 px-9 text-[1.0625rem]">
        <Icon name="download" size={20} />
        {t.hero.cta}
      </a>
      <p class="text-caption text-dust" set:html={caption} />
    </div>
    <p class="mt-5 text-[0.9375rem] leading-relaxed text-cream-soft" role="note">
      <Icon name="signal" size={20} class="me-1.5 inline-block align-[-4px] text-bulb" />
      <strong class="font-semibold text-cream">{t.hero.earthlinkTitle}.</strong>{' '}{t.hero.earthlink}
    </p>
  </div>

  <Devices locale={locale} class="mt-12 sm:mt-14" />

  <ul
    aria-label={t.hero.platformsLabel}
    class="mt-8 flex flex-wrap justify-center gap-x-5 gap-y-2 text-caption text-dust sm:mt-10 sm:gap-x-7"
  >
    {
      t.hero.platforms.map((name, i) => (
        <li class="inline-flex items-center gap-2">
          <Icon name={platformIcons[i]!} size={18} />
          <bdi>{name}</bdi>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The sign: bulbs round the edge, the board in the middle. */
  .sign {
    display: grid;
    grid-template-columns: 6px minmax(0, 1fr) 6px;
    grid-template-rows: 6px auto 6px;
    gap: 0.875rem;
    padding: 0.875rem;
  }
  .sign :global(.top) {
    grid-area: 1 / 1 / 2 / 4;
  }
  .sign :global(.bottom) {
    grid-area: 3 / 1 / 4 / 4;
  }
  .sign :global(.side-start) {
    grid-area: 2 / 1;
  }
  .sign :global(.side-end) {
    grid-area: 2 / 3;
  }
  .board {
    grid-area: 2 / 2;
  }
  @media (min-width: 37.5rem) {
    .sign {
      gap: 1.25rem;
      padding: 1.25rem;
    }
  }

  /* Below 64rem: one line per entry, each balanced if it has to break.
     From 64rem: the whole headline on one line, like letters on a marquee board. */
  .headline .line {
    display: block;
    text-wrap: balance;
  }
  .headline {
    font-size: clamp(2.75rem, 12.5vw, 6rem);
    font-weight: 900;
    line-height: 0.96;
    text-transform: uppercase;
    letter-spacing: 0.005em;
  }
  /* Arabic: Reem Kufi is wider and needs room between lines. */
  .headline:lang(ar) {
    font-size: clamp(2.5rem, 10.5vw, 5rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
  }
  @media (min-width: 64rem) {
    .headline .line {
      display: inline;
    }
    .headline {
      font-size: clamp(3.75rem, 6.1vw, 5.75rem);
    }
    .headline:lang(ar) {
      font-size: clamp(3.5rem, 6.6vw, 6.25rem);
    }
  }
</style>
