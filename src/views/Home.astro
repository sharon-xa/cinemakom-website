---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Ticket from '../components/Ticket.astro';
import Programme from '../components/Programme.astro';
import Screens from '../components/Screens.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Refresh from '../components/Refresh.astro';
import { dict, type Locale } from '../i18n';
import { getRelease } from '../lib/release';
import { jsonLd } from '../lib/seo';
import { absolute } from '../lib/url';
import { screen } from '../lib/screens';
import { getImage } from 'astro:assets';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
const release = await getRelease();
// Screenshots for search results: the hero shots, as WebP.
const shots = await Promise.all(
  [`phone-home-${locale}`, 'desktop-home-en'].map((name) => getImage({ src: screen(name), format: 'webp', width: 1280 })),
);
const structured = jsonLd({
  locale,
  page: 'home',
  title: t.meta.title,
  description: t.meta.description,
  release,
  screenshots: shots.map((s) => absolute(s.src)),
  faq: true,
});
---

<Base locale={locale} page="home" title={t.meta.title} ogTitle={t.meta.ogTitle} description={t.meta.description} jsonLd={structured} release={release.tag}>
  <Header locale={locale} />
  <main id="main">
    <Hero locale={locale} release={release} />
    <Ticket locale={locale} />
    <Programme locale={locale} />
    <Screens locale={locale} />
    <Download locale={locale} release={release} />
    <Faq locale={locale} />
  </main>
  <Footer locale={locale} page="home" />
  <Refresh />
</Base>
