---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dict(locale);
---

<Base locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <Header locale={locale} />
  <main id="main" class="wrap py-16">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 class="font-display text-hero font-black text-cream">{t.hero.headline.join(' ')}</h1>
    <p class="max-w-[65ch] text-cream-soft">{t.hero.lede}</p>
  </main>
  <Footer locale={locale} page="home" />
</Base>
